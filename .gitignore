.ruff_cache/

# ML model caches (downloaded at runtime, not vendored)
*.onnx
*.pt
*.task
*.task.part
!attune/assets/**/*.onnx
.cache/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Qt
*.qmlc
*.jsc

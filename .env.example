# Copy to .env and fill in as needed. Nothing here is required to run Attune locally with
# the default Ollama provider — cloud LLM keys are only read if ATTUNE_LLM__PROVIDER selects them.

# --- Core ---
ATTUNE_DEBUG=false
ATTUNE_THEME=dark
ATTUNE_LOG_LEVEL=INFO
ATTUNE_LOG_JSON=false

# --- API server ---
ATTUNE_API_HOST=127.0.0.1
ATTUNE_API_PORT=8420

# --- Storage ---
ATTUNE_DATABASE_URL=sqlite+aiosqlite:///./attune.db
ATTUNE_DATA_DIR=./data

# --- Camera ---
ATTUNE_CAMERA__DEVICE_INDEX=0
ATTUNE_CAMERA__FPS=30
ATTUNE_CAMERA__INFERENCE_FPS=8
ATTUNE_CAMERA__WIDTH=1280
ATTUNE_CAMERA__HEIGHT=720

# --- Privacy (local-only by default; nothing leaves the device unless cloud_ai_enabled=true) ---
ATTUNE_PRIVACY__CLOUD_AI_ENABLED=false
ATTUNE_PRIVACY__DEBUG_SAVE_FRAMES=false
ATTUNE_PRIVACY__DATA_RETENTION_DAYS=90

# --- Performance ---
ATTUNE_PERFORMANCE__CONFIDENCE_THRESHOLD=0.6

# --- LLM provider selection (openai | gemini | claude | groq | ollama) ---
ATTUNE_LLM__PROVIDER=ollama
ATTUNE_LLM__MODEL=llama3.1

# --- LLM provider API keys (only the selected provider's key is ever read) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Ollama runs locally — no key needed, just OLLAMA_HOST if not http://localhost:11434
OLLAMA_HOST=
